# Copie para .env na raiz do repositório.
# Sem chaves, o MenuMatch usa o orquestrador local com as mesmas ferramentas.

# auto | local | gemini | openai
LLM_PROVIDER=auto

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# sqlite local ou postgresql+psycopg://user:pass@localhost:5432/menumatch
DATABASE_URL=sqlite:///./menumatch.db

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Estimativa exibida no painel: minutos de navegação no cardápio vs. decisão com o agente
BROWSE_MINUTES=4.2
AGENT_MINUTES=0.7

# minilm usa paraphrase-multilingual-MiniLM-L12-v2 (português) e grava FAISS.
# tfidf volta ao índice esparso, sem baixar modelo.
EMBEDDING_PROVIDER=minilm
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
